QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379/0

# --- Paths ---
DATA_DIR=./data
RAW_DIR=./data/raw
OCR_DIR=./data/ocr
EXTRACTED_DIR=./data/extracted
CHUNKS_DIR=./data/chunks
