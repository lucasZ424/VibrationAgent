# Historical sanitized environment snapshot for Vibration Agent.
# Runtime configuration now uses local .env only. This file is ignored going
# forward and should not receive real keys.

# --- Workspace / dotenv ---
VIBRATION_AGENT_HOME=
VIBRATION_AGENT_DISABLE_DOTENV=

# --- Runtime ---
APP_NAME=vibration-agent
LOG_LEVEL=INFO
DEFAULT_USER_MODE=engineering

# --- Phase-3 manual live / capture gates ---
# Keep false in this historical snapshot. Set both true only in your local .env
# when you intentionally run manual live/capture commands.
LLM_LIVE_ENABLED=false
LLM_CAPTURE_ENABLED=false
LLM_REPLAY_DIR=tests/fixtures/llm
LLM_TOKEN_BUDGET_PER_TASK=4000
LLM_TOKEN_BUDGET_PER_SESSION=30000
LLM_USD_BUDGET_PER_TASK=

# --- OpenAI provider ---
OPENAI_API_KEY=
OPENAI_API_KEY_ENV=OPENAI_API_KEY
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=30.0
OPENAI_REASONING_EFFORT=high
OPENAI_TEXT_VERBOSITY=high
OPENAI_INPUT_USD_PER_MILLION_TOKENS=5.0
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=30.0
OPENAI_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.5

# --- Anthropic provider ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_ENV=ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=30.0
ANTHROPIC_INPUT_USD_PER_MILLION_TOKENS=5.0
ANTHROPIC_OUTPUT_USD_PER_MILLION_TOKENS=25.0
ANTHROPIC_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.5

# --- LLM skill feature flags ---
S3_LLM_ENABLED=false
S4_LLM_ENABLED=false
S5_LLM_ENABLED=false
S3_LLM_TIMEOUT=10.0

# --- Paths ---
DATA_DIR=./data
RAW_DIR=./data/raw
OCR_DIR=./data/ocr
EXTRACTED_DIR=./data/extracted
CHUNKS_DIR=./data/chunks
EMBEDDINGS_DIR=./data/embeddings
EXPORTS_DIR=./data/exports

# --- Databases / stores ---
POSTGRES_ENABLED=false
POSTGRES_URL=postgresql+psycopg://vib:vib@localhost:5432/vibration
POSTGRES_TIMEOUT=2.0
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT=2.0
REDIS_URL=redis://localhost:6379/0

# --- OCR / ingestion ---
OCR_TEXT_DENSITY_THRESHOLD=0.2
OCR_PRIMARY=paddleocr
OCR_FALLBACK=tesseract
PADDLEOCR_LANG=ch
TESSERACT_LANGS=chi_sim+eng+osd
OCR_LOW_CONFIDENCE_THRESHOLD=0.6
OCR_RENDER_DPI=220
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval / embeddings ---
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_ENABLED=false
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_FALLBACK_TO_TOKEN_FEATURES=true
EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
EMBEDDING_TIMEOUT=30.0

# --- Routing ---
ROUTING_DEFAULT_OWNER=gpt

# --- V1 normalization ---
V1_ENABLED=true
V1_INPUT_ENABLED=false
V1_OUTPUT_ENABLED=true

# --- Local API hardening ---
API_AUTH_ENABLED=false
API_KEY=
API_CORS_ENABLED=false
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=60
